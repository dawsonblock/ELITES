{
  "name": "escape-the-elites-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude e2e",
    "test:watch": "vitest --exclude e2e",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:prod": "npm run build && playwright test --config playwright.prod.config.ts",
    "clean": "rm -rf dist test-results playwright-report",
    "verify": "npm run lint && npm test && npm run build",
    "verify:full": "npm run clean && npm run lint && npm test && npm run build && npm run test:e2e && npm run test:e2e:prod",
    "verify:package": "npm run clean && npm run verify:release-package",
    "verify:release-package": "node scripts/verify-release.mjs",
    "verify:release-package:strict": "node scripts/verify-release.mjs --strict",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "playcanvas": "^2.19.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
