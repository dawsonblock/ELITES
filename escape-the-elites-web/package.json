{
  "name": "escape-the-elites-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude e2e",
    "test:watch": "vitest --exclude e2e",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:prod": "npm run build && playwright test --config playwright.prod.config.ts",
    "verify": "npm run lint && npm test && npm run build",
    "verify:full": "npm run verify:release-package && npm run lint && npm test && npm run build && npm run test:e2e && npm run test:e2e:prod",
    "verify:release-package": "node scripts/verify-release.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "playcanvas": "^1.71.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.0.3"
  }
}
